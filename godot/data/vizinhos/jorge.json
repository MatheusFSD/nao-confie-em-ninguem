  "avisos": {
    "1": {
      "verdade": "Compra hoje. Racionamento que começa 'temporário' nunca termina na data."
    },
    "2": {
      "verdade": "Enche as garrafas enquanto tem água. E não diz pro sargento quantos moram aí."
    },
    "3": {
      "verdade": "Se a água vier com gosto estranho, ferve. Aviso oficial não ferve água pra ninguém."
    },
    "4": {
      "verdade": "Amanhã acaba a água. Enche tudo hoje."
    },
    "5": {
      "verdade": "Amanhã a luz cai e o ônibus para. Pilha hoje. E porta trancada de noite: tem gente entrando nas casas."
    },
    "6": {
      "verdade": "Eles não enxergam, escutam. Anda devagar, abaixado, e não bate portão."
    },
    "7": {
      "verdade": "Hoje a rua tá sem bicho, o barulho é no centro. Se tiver que buscar alguém, é hoje."
    },
    "8": {
      "verdade": "De dia eles enchem a rua; de noite, poucos. E o alto de olho aceso trabalha pra eles: se te vê, grita."
    },
    "9": {
      "verdade": "Tem barricada no fim da rua. Hoje mandam voltar amanhã. E se quem sumiu bater na sua porta, não abre. Nem faz pergunta."
    },
    "10": {
      "verdade": "A barricada abre hoje até escurecer. Diz seu nome e espera perguntarem."
    }
  },
