  "avisos": {
    "1": {
      "verdade": "Compra hoje. Amanhã é uma embalagem só por loja. Eu esqueci de comprar e tô me arrependendo."
    },
    "2": {
      "verdade": "Enche as garrafas enquanto tem água. O depósito do André já tá sem galão."
    },
    "3": {
      "verdade": "Se a água vier com gosto estranho, ferve antes de beber."
    },
    "4": {
      "verdade": "Amanhã a água acaba. Enche tudo hoje."
    },
    "5": {
      "verdade": "Amanhã a luz some e o ônibus para. Pilha hoje. E tranca a porta de noite."
    },
    "6": {
      "verdade": "Eles não veem, escutam. Anda devagar e abaixado. E não responde se alguém chamar lá fora."
    },
    "7": {
      "verdade": "Hoje a rua tá vazia deles; o barulho é todo no centro. Se tiver alguém pra buscar, busca hoje."
    },
    "8": {
      "verdade": "De dia eles tomam a rua; de noite sobram poucos. E se o alto de olho aceso te ver, ele grita e chama os outros."
    },
    "9": {
      "verdade": "Tem barricada no fim da rua. Mandam voltar amanhã. E se quem sumiu bater na sua porta, não abre. Eu não abri."
    },
    "10": {
      "verdade": "A barricada abre hoje, até escurecer. Vai antes do escuro."
    }
